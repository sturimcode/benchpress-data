    },
    {
      "settingId": "crowd-density",
      "from": "High",
      "to": "Medium",
      "estGainPct": 3,
      "visualNote": "Fewer pedestrians downtown. Helps most on CPU-limited rigs.",
      "source": { "name": "r/OptimizedGaming Cyberpunk guide", "url": "https://www.reddit.com/r/OptimizedGaming/" }
    },
    {
      "settingId": "ambient-occlusion",
      "from": "High",
