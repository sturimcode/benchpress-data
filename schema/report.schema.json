{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BenchPress benchmark report",
  "type": "object",
  "required": ["schemaVersion", "submittedAt", "game", "hardware", "settings", "results", "methodology"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^1\\.\\d+\\.\\d+$" },
    "submittedAt": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])(T.*)?$" },
    "game": {
      "type": "object",
      "required": ["slug"],
      "additionalProperties": false,
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "gameVersion": { "type": "string" }
      }
    },
    "hardware": {
      "type": "object",
      "required": ["gpu", "cpu", "ramGb", "resolution"],
      "additionalProperties": false,
      "properties": {
        "gpu": { "type": "string", "minLength": 1 },
        "cpu": { "type": "string", "minLength": 1 },
        "ramGb": { "type": "integer", "minimum": 4 },
        "resolution": { "type": "string", "pattern": "^\\d{3,4}x\\d{3,4}$" },
        "driverVersion": { "type": "string" }
      }
    },
    "settings": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "results": {
      "type": "object",
      "required": ["avgFps", "onePercentLowFps"],
      "additionalProperties": false,
      "properties": {
        "avgFps": { "type": "number", "exclusiveMinimum": 0 },
        "onePercentLowFps": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "methodology": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["built-in-benchmark", "free-play"] },
        "durationSec": { "type": "integer", "minimum": 30 }
      },
      "if": { "properties": { "type": { "const": "free-play" } } },
      "then": { "required": ["type", "durationSec"] }
    },
    "delta": {
      "type": "object",
      "required": ["settingId", "from", "to", "comparedToAvgFps"],
      "additionalProperties": false,
      "properties": {
        "settingId": { "type": "string", "minLength": 1 },
        "from": { "type": ["string", "number", "boolean"] },
        "to": { "type": ["string", "number", "boolean"] },
        "comparedToAvgFps": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
